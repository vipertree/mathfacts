# Django
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-random-50-byte-string
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (dev uses sqlite; prod sets a real DATABASE_URL, e.g. postgres://... )
DATABASE_URL=sqlite:///db.sqlite3

# Production-only toggles (leave default in dev)
# CSRF_TRUSTED_ORIGINS=https://adderoaks.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# FORCE_SCRIPT_NAME=/mathfacts
